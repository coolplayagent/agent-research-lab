load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files([
    "Cargo.toml",
    "src/main.rs",
    "systemd/agent-research-lab.service",
    "systemd/agent-research-lab-dashboard.service",
], visibility = ["//visibility:public"])

rust_library(
    name = "app_service",
    crate_name = "agent_research_lab",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    aliases = aliases(),
    version = "0.1.0",
    rustc_env = {"CARGO_PKG_NAME": "agent-research-lab"},
    deps = ["//apps/research-cli:research_cli"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    crate = ":app_service",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "serde_compatibility_tests",
    srcs = ["tests/serde_compatibility.rs"],
    crate_root = "tests/serde_compatibility.rs",
    edition = "2024",
    compile_data = glob(["tests/fixtures/**"]),
    aliases = aliases(normal = True, normal_dev = True, proc_macro = True, proc_macro_dev = True),
    deps = [":app_service"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    visibility = ["//visibility:public"],
)

filegroup(name = "policy_sources", srcs = glob(["src/**/*.rs", "tests/**/*.rs", "src/**/*.ts", "*.html", "src/dashboard/*.html"], exclude = ["tests/fixtures/**"], allow_empty = True), visibility = ["//visibility:public"])

rust_test(
    name = "enqueue_batch_cli_tests",
    srcs = ["tests/enqueue_batch_cli.rs"],
    compile_data = ["tests/fixtures/enqueue_batch_cli.py"],
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = ["//crates/process:process"] + all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
