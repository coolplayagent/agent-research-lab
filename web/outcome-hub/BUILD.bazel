load("//web:defs.bzl", "typescript")

typescript(
    name = "compiled",
    srcs = glob(["src/**/*.ts"]) + ["//web/shared:types"],
    config = "tsconfig.json",
    visibility = ["//visibility:public"],
)
filegroup(
    name = "assets",
    srcs = glob(["dist/**/*.js", "*.html", "*.css", "*.svg"]),
    visibility = ["//visibility:public"],
)
genrule(
    name = "checked",
    srcs = [":compiled"] + glob(["dist/**/*.js"]),
    outs = ["typescript.checked"],
    cmd = "diff -r $(location :compiled) web/outcome-hub/dist && touch $@",
    visibility = ["//visibility:public"],
)

filegroup(name = "policy_sources", srcs = glob(["src/**/*.rs", "tests/**/*.rs", "src/**/*.ts", "*.html", "src/dashboard/*.html"], exclude = ["tests/fixtures/**"], allow_empty = True), visibility = ["//visibility:public"])

load("//web:defs.bzl", "node_test")
node_test(
    name = "workspace_tests",
    script = "workspace-tests.cjs",
    data = [":policy_sources", "//web/shared:policy_sources"],
)
node_test(
    name = "layout_tests",
    script = "layout-tests.cjs",
    data = [":policy_sources", "//web/shared:policy_sources"],
)
node_test(
    name = "bootstrap_tests",
    script = "bootstrap-tests.cjs",
    data = [":policy_sources"],
)
node_test(
    name = "iteration_tests",
    script = "iteration-tests.cjs",
    data = [":policy_sources", "//web/shared:policy_sources"],
)

load("@rules_rust//rust:defs.bzl", "rust_library")
exports_files(["Cargo.toml"])
rust_library(name = "outcome_hub_web", srcs = ["src/lib.rs"], deps = ["//web/shared:web_assets"], compile_data = [":assets", ":checked"], edition = "2024", visibility = ["//visibility:public"])
node_test(
    name = "settings_tests",
    script = "settings-tests.cjs",
    data = [":policy_sources", "//web/shared:policy_sources"],
)

node_test(
    name = "binding_knowledge_tests",
    script = "binding-knowledge-tests.cjs",
    data = [":policy_sources", "//web/shared:policy_sources"],
)
