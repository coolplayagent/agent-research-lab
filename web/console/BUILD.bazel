load("//web:defs.bzl", "typescript")

typescript(
    name = "compiled",
    srcs = glob(["src/**/*.ts"]) + ["//web/shared:types"],
    config = "tsconfig.json",
    visibility = ["//visibility:public"],
)
filegroup(
    name = "assets",
    srcs = glob(["dist/**/*.js", "*.html", "*.css"]),
    visibility = ["//visibility:public"],
)
genrule(
    name = "checked",
    srcs = [":compiled"] + glob(["dist/**/*.js"]),
    outs = ["typescript.checked"],
    cmd = "diff -r $(location :compiled) web/console/dist && touch $@",
    visibility = ["//visibility:public"],
)

filegroup(name = "policy_sources", srcs = glob(["src/**/*.rs", "tests/**/*.rs", "src/**/*.ts", "*.html", "src/dashboard/*.html"], exclude = ["tests/fixtures/**"], allow_empty = True), visibility = ["//visibility:public"])

load("@rules_rust//rust:defs.bzl", "rust_library")
exports_files(["Cargo.toml"])
rust_library(name = "console_web", srcs = ["src/lib.rs"], compile_data = [":assets", ":checked"], edition = "2024", visibility = ["//visibility:public"])
