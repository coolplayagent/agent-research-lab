load("//web:defs.bzl", "typescript")

typescript(
    name = "compiled",
    srcs = glob(["src/*.ts"]),
    config = "tsconfig.json",
    visibility = ["//visibility:public"],
)
filegroup(
    name = "assets",
    srcs = glob(["dist/*.js", "*.html", "*.css"]),
    visibility = ["//visibility:public"],
)
genrule(
    name = "checked",
    srcs = [":compiled"] + glob(["dist/*.js"]),
    outs = ["typescript.checked"],
    cmd = "diff -r $(location :compiled) crates/im-service/web/dist && touch $@",
    visibility = ["//visibility:public"],
)
