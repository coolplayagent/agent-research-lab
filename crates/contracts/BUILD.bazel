load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files([
    "Cargo.toml",
], visibility = ["//visibility:public"])

rust_library(
    name = "contracts",
    crate_name = "contracts",
    srcs = ["src/lib.rs"],
    crate_root = "src/lib.rs",
    edition = "2024",
    aliases = aliases(),
    deps = [
    ] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    crate = ":contracts",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    visibility = ["//visibility:public"],
)

rust_binary(name = "generate", srcs = ["src/bin/generate.rs"], edition = "2024", deps = [":contracts"], visibility = ["//visibility:public"])

filegroup(name = "policy_sources", srcs = glob(["src/**/*.rs", "tests/**/*.rs", "src/**/*.ts", "*.html", "src/dashboard/*.html"], exclude = ["tests/fixtures/**"], allow_empty = True), visibility = ["//visibility:public"])

rust_test(name = "boundary_tests", srcs = ["tests_boundaries.rs"], edition = "2024", compile_data = ["//:source_inventory"], data = ["//:policy_sources"], visibility = ["//visibility:public"])
