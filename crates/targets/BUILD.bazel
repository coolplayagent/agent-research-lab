load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files([
    "Cargo.toml",
], visibility = ["//visibility:public"])

rust_library(
    name = "targets",
    crate_name = "targets",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    aliases = aliases(),
    compile_data = ["//:desktop_assets"],
    deps = [
        "//crates/agent-backend:agent_backend",
        "//crates/agent-policy:agent_policy",
        "//crates/config:config",
        "//crates/isolation:isolation",
        "//crates/process:process",
        "//crates/storage:storage",
    ] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    crate = ":targets",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = [
        "//crates/workflow:workflow",
    ] + all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    visibility = ["//visibility:public"],
)

filegroup(name = "policy_sources", srcs = glob(["src/**/*.rs", "tests/**/*.rs", "src/**/*.ts", "*.html", "src/dashboard/*.html"], exclude = ["tests/fixtures/**"], allow_empty = True), visibility = ["//visibility:public"])
