load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_binary")
exports_files(["Cargo.toml"], visibility = ["//visibility:public"])
rust_library(
    name = "im_storage", crate_name = "im_storage",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    compile_data = glob(["fixtures/*"]),
    crate_root = "src/lib.rs", edition = "2024", aliases = aliases(),
    deps = ["//crates/im-client:im_client", "//crates/crystal:crystal", "//crates/contracts:contracts", "//crates/service-protocol:service_protocol"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)
rust_test(name = "tests", crate = ":im_storage", aliases = aliases(normal_dev = True, proc_macro_dev = True), deps = [] + all_crate_deps(normal_dev = True), proc_macro_deps = all_crate_deps(proc_macro_dev = True), visibility = ["//visibility:public"])
filegroup(name = "policy_sources", srcs = glob(["src/**/*.rs", "src/dashboard/*.html", "src/dashboard/*.css"], allow_empty = True), visibility = ["//visibility:public"])
rust_binary(name = "ai-im-storage", srcs = ["src/main.rs"], edition = "2024", deps = [":im_storage"] + ["//crates/im-client:im_client", "//crates/crystal:crystal", "//crates/contracts:contracts", "//crates/service-protocol:service_protocol"] + all_crate_deps(normal = True), proc_macro_deps = all_crate_deps(proc_macro = True), visibility = ["//visibility:public"])
filegroup(name = "units", srcs = glob(["systemd/*.service"]), visibility = ["//visibility:public"])
