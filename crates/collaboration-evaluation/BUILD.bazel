load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files([
    "Cargo.toml",
], visibility = ["//visibility:public"])

rust_library(
    name = "collaboration_experiment",
    crate_name = "collaboration_experiment",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    aliases = aliases(),
    deps = [
        "//crates/contracts:contracts",
        "//crates/execution-config:config",
        "//crates/prompt-evolution-cli:evolution_cli",
        "//crates/prompt-evolution:evolution",
        "//crates/execution-inputs:inputs",
        "//crates/process:process",
        "//crates/execution-runtime:runtime",
        "//crates/filesystem-store:storage",
        "//crates/workflow-adapter:workflow",
    ] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    crate = ":collaboration_experiment",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    visibility = ["//visibility:public"],
)

filegroup(name = "policy_sources", srcs = glob(["src/**/*.rs", "tests/**/*.rs", "src/**/*.ts", "*.html", "src/dashboard/*.html"], exclude = ["tests/fixtures/**"], allow_empty = True), visibility = ["//visibility:public"])
