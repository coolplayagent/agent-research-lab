load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary", "rust_test")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "pkg_attributes")
exports_files(["Cargo.toml"])
rust_library(
    name = "collaboration_api",
    crate_name = "collaboration_api",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_root = "src/lib.rs",
    compile_data = ["//web/outcome-hub:assets", "//web/outcome-hub:checked"],
    edition = "2024",
    aliases = aliases(),
    deps = ["//crates/knowledge-client:knowledge_client", "//crates/knowledge-model:knowledge_model", "//web/outcome-hub:outcome_hub_web", "//web/shared:web_assets", "//crates/contracts:contracts", "//crates/service-protocol:service_protocol", "//crates/collaboration-model:collaboration_model", "//crates/service-api:service_api", "//crates/collaboration-client:collaboration_client", "//crates/service-registry:service_registry", "//crates/filesystem-store:storage"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)
rust_test(
    name = "tests",
    crate = ":collaboration_api",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = ["//crates/collaboration-store:collaboration_store", "//crates/collaboration-storage-service:collaboration_storage_service"] + all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    visibility = ["//visibility:public"],
)
pkg_files(
    name = "core-files",
    srcs = ["//apps/outcome-hub:outcome-hub", "//crates/collaboration-storage-service:outcome-hub-storage"],
    attributes = pkg_attributes(mode = "0755"),
)
pkg_tar(
    name = "package",
    srcs = [":core-files", "//deploy/systemd:outcome-hub.service", "//crates/collaboration-storage-service:units"],
    package_dir = "outcome-hub",
    extension = "tar.gz",
    mode = "0755",
    visibility = ["//visibility:public"],
)

filegroup(name = "policy_sources", srcs = glob(["src/**/*.rs", "tests/**/*.rs", "src/**/*.ts", "*.html", "src/dashboard/*.html"], exclude = ["tests/fixtures/**"], allow_empty = True), visibility = ["//visibility:public"])
