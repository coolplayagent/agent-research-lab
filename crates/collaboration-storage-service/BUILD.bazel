load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_binary")
exports_files(["Cargo.toml"], visibility = ["//visibility:public"])
rust_library(
    name = "collaboration_storage_service", crate_name = "collaboration_storage_service",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs", "src/legacy_main.rs"]),
    compile_data = glob(["fixtures/*"]),
    crate_root = "src/lib.rs", edition = "2024", aliases = aliases(),
    deps = ["//crates/collaboration-client:collaboration_client", "//crates/collaboration-store:collaboration_store", "//crates/contracts:contracts", "//crates/service-protocol:service_protocol"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)
rust_test(name = "tests", crate = ":collaboration_storage_service", aliases = aliases(normal_dev = True, proc_macro_dev = True), deps = [] + all_crate_deps(normal_dev = True), proc_macro_deps = all_crate_deps(proc_macro_dev = True), visibility = ["//visibility:public"])
filegroup(name = "policy_sources", srcs = glob(["src/**/*.rs", "src/dashboard/*.html", "src/dashboard/*.css"], allow_empty = True), visibility = ["//visibility:public"])
rust_binary(name = "ai-im-storage", srcs = ["src/main.rs"], edition = "2024", deps = [":collaboration_storage_service"] + ["//crates/collaboration-client:collaboration_client", "//crates/collaboration-store:collaboration_store", "//crates/contracts:contracts", "//crates/service-protocol:service_protocol"] + all_crate_deps(normal = True), proc_macro_deps = all_crate_deps(proc_macro = True), visibility = ["//visibility:public"])
filegroup(name = "units", srcs = ["//deploy/systemd:storage_units"], visibility = ["//visibility:public"])

rust_binary(name = "outcome-hub-storage", srcs = ["src/main.rs"], edition = "2024", deps = [":collaboration_storage_service"] + ["//crates/collaboration-client:collaboration_client", "//crates/collaboration-store:collaboration_store", "//crates/contracts:contracts", "//crates/service-protocol:service_protocol"] + all_crate_deps(normal = True), proc_macro_deps = all_crate_deps(proc_macro = True), visibility = ["//visibility:public"])
