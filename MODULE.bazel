module(name = "agent_research_lab", version = "0.1.1")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "rules_shell", version = "0.6.1")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2024", versions = ["1.97.1"])
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

# The root Cargo workspace resolves app/ and every crates/ member.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

# Pinned frontend toolchain; release packages embed precompiled ES modules.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "im_node",
    urls = ["https://nodejs.org/dist/v22.22.1/node-v22.22.1-linux-x64.tar.xz"],
    sha256 = "9a6bc82f9b491279147219f6a18add1e18424dce90d41d2a5fcd69d4924ba3aa",
    strip_prefix = "node-v22.22.1-linux-x64",
    build_file_content = 'exports_files(["bin/node"], visibility = ["//visibility:public"])',
)
http_archive(
    name = "im_node_windows",
    urls = ["https://nodejs.org/dist/v22.22.1/node-v22.22.1-win-x64.zip"],
    sha256 = "877cb93829e14fffbbc7903e7d8037336c9a79f3ea43c5d0b8c2379b79da56de",
    strip_prefix = "node-v22.22.1-win-x64",
    build_file_content = 'exports_files(["node.exe"], visibility = ["//visibility:public"])',
)
http_archive(
    name = "im_typescript",
    urls = ["https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz"],
    sha256 = "10e108c9cf7d5f2879053dff18515fb405abf2ccef63eaaf017d9c571687a1d3",
    strip_prefix = "package",
    build_file_content = 'exports_files(["bin/tsc", "lib/typescript.js"], visibility = ["//visibility:public"])\nfilegroup(name="compiler", srcs=glob(["lib/**", "bin/**"]), visibility=["//visibility:public"])',
)

# Pinned Markdown renderer for the reproducible static documentation site.
http_archive(
    name = "im_marked",
    urls = ["https://registry.npmjs.org/marked/-/marked-16.4.2.tgz"],
    sha256 = "f8f87a61f0f9668a675309224c55a9bb96c04592bbf757de5de40af7d2dec872",
    strip_prefix = "package",
    build_file_content = 'exports_files(["lib/marked.esm.js", "LICENSE.md"], visibility = ["//visibility:public"])',
)
