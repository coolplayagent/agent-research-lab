load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")
exports_files(["Cargo.toml", "src/main.rs"], visibility = ["//visibility:public"])
rust_binary(name = "ai-im", srcs = ["src/main.rs"], edition = "2024", deps = ["//crates/im-host:im_host", "//crates/storage:storage"] + all_crate_deps(normal = True), proc_macro_deps = all_crate_deps(proc_macro = True), visibility = ["//visibility:public"])
filegroup(name = "policy_sources", srcs = glob(["src/**/*.rs", "tests/**/*.rs"]), visibility = ["//visibility:public"])

load("@rules_rust//rust:defs.bzl", "rust_test")
rust_test(
    name = "standalone_tests", srcs = ["tests/standalone.rs"], edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_ai-im": "$(rootpath :ai-im)"},
    data = [":ai-im"], deps = all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    visibility = ["//visibility:public"],
)
