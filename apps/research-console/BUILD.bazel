load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_binary")
exports_files(["Cargo.toml"], visibility = ["//visibility:public"])
rust_library(
    name = "research_console", crate_name = "research_console",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_root = "src/lib.rs", edition = "2024", aliases = aliases(),
    compile_data = glob(["src/dashboard/fixtures/*", "src/dashboard/*.html", "src/dashboard/*.css"]) + ["//apps/research-console/src/dashboard/web:assets", "//apps/research-console/src/dashboard/web:checked"],
