load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_rust//rust:defs.bzl", "rust_binary")

exports_files(["Cargo.toml", "Cargo.lock"])

filegroup(
    name = "prompt_assets",
    srcs = glob(["prompts/*.md"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "evolution_examples",
    srcs = glob(["examples/evolution/*.json"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "desktop_assets",
    srcs = glob(["assets/desktop/*"]),
    visibility = ["//visibility:public"],
)

alias(
    name = "agent_research_lab",
    actual = "//apps/cli:outcome_hub_cli",
    visibility = ["//visibility:public"],
)

# Keep the executable at bazel-bin/agent-research-lab for service and package users.
rust_binary(
    name = "agent-research-lab",
    version = "0.1.0",
    srcs = ["//apps/cli:src/main.rs"],
    crate_root = "//apps/cli:src/main.rs",
    edition = "2024",
    aliases = aliases(package_name = "apps/cli"),
    deps = ["//apps/cli:outcome_hub_cli"] + all_crate_deps(normal = True, package_name = "apps/cli"),
    proc_macro_deps = all_crate_deps(proc_macro = True, package_name = "apps/cli"),
    visibility = ["//visibility:public"],
)

test_suite(
    name = "tests",
    tests = [
        "//crates/software-verification:tests",
        "//crates/software-delivery:tests",
        "//crates/service-registry:tests",
        "//crates/sandbox-service:tests",
        "//crates/executor-service:tests",
        "//crates/outcome-service:tests",
        "//crates/codex-adapter:tests",
        "//crates/collaboration-host:tests",
        "//crates/collaboration-client:tests",
        "//crates/collaboration-model:tests",
        "//apps/console:tests",
        "//apps/cli:tests",
        "//architecture:tests",
        "//apps/outcome-hub:standalone_tests",
        "//apps/cli:serde_compatibility_tests",
        "//crates/collaboration-api:tests",
        "//crates/agent-backend:tests",
        "//crates/agent-policy:tests",
        "//crates/delivery-outbox:tests",
        "//crates/execution-budget:tests",
        "//crates/build-cache:tests",
        "//crates/collaboration-evaluation:tests",
        "//crates/collaboration-proposals:tests",
        "//crates/collaboration-store:tests",
        "//crates/execution-config:tests",
        "//crates/delivery-adapters:tests",
        "//crates/prompt-evolution:tests",
        "//crates/prompt-evolution-cli:tests",
        "//crates/source-freshness:tests",
        "//crates/execution-inputs:tests",
        "//crates/isolation:tests",
        "//crates/knowledge-publication:tests",
        "//crates/lease-heartbeat:tests",
        "//crates/agent-teams:tests",
        "//crates/process:tests",
        "//crates/native-effects:tests",
        "//crates/execution-runtime:tests",
        "//crates/filesystem-store:tests",
        "//crates/execution-targets:tests",
        "//crates/execution-model:tests",
        "//crates/workflow-adapter:tests",
    ],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "package",
    srcs = [
        ":agent-research-lab",
        ":outcome-hub-cli",
        "//crates/knowledge-service:outcome-hub-knowledge",
        "//crates/collaboration-storage-service:ai-im-storage",
        "//crates/collaboration-storage-service:units",
        "//crates/service-workers:ai-im-services",
        "//crates/service-workers:ai-im-codex-adapter",
        "//crates/service-workers:ai-im-outcome-service",
        "//crates/service-workers:units",
        "//deploy/systemd:agent-research-lab.service",
        "//deploy/systemd:agent-research-lab-dashboard.service",
    ] + glob(["docs/**", "examples/**", "prompts/**", "research/**", "skills/**", "assets/**", "*.md"]),
    package_dir = "outcome-hub",
    strip_prefix = ".",
    extension = "tar.gz",
    mode = "0755",
    visibility = ["//visibility:public"],
)

# Minimal AI-IM core package; the main system also supports optional research scenarios.
alias(name = "ai-im", actual = "//crates/collaboration-api:ai-im", visibility = ["//visibility:public"])
alias(name = "im-package", actual = "//crates/collaboration-api:package", visibility = ["//visibility:public"])

filegroup(name = "policy_sources", srcs = [
