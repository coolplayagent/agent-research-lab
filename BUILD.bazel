    "//crates/executor-service:policy_sources",
    "//apps/console:policy_sources",
    "//crates/software-verification:policy_sources",
    "//crates/software-delivery:policy_sources",
    "//apps/outcome-hub:policy_sources",
    "//crates/service-workers:policy_sources",
    "//crates/service-api:policy_sources",
    "//crates/collaboration-storage-service:policy_sources",
    "//crates/service-protocol:policy_sources",
    "//apps/cli:policy_sources",
    "//crates/agent-backend:policy_sources",
    "//crates/build-cache:policy_sources",
    "//crates/collaboration-api:policy_sources",
    "//crates/lease-heartbeat:policy_sources",
    "//crates/contracts:policy_sources",
    "//crates/execution-budget:policy_sources",
    "//crates/process:policy_sources",
    "//crates/native-effects:policy_sources",
    "//crates/agent-policy:policy_sources",
    "//crates/collaboration-evaluation:policy_sources",
    "//crates/prompt-evolution-cli:policy_sources",
    "//crates/isolation:policy_sources",
    "//crates/collaboration-store:policy_sources",
    "//crates/prompt-evolution:policy_sources",
    "//crates/delivery-outbox:policy_sources",
    "//crates/filesystem-store:policy_sources",
    "//crates/execution-targets:policy_sources",
    "//crates/knowledge-publication:policy_sources",
    "//crates/agent-teams:policy_sources",
    "//crates/delivery-adapters:policy_sources",
    "//crates/execution-config:policy_sources",
    "//crates/collaboration-proposals:policy_sources",
