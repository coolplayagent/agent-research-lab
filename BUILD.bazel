load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_rust//rust:defs.bzl", "rust_binary")

exports_files(["Cargo.toml", "Cargo.lock"])

filegroup(
    name = "prompt_assets",
    srcs = glob(["prompts/*.md"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "evolution_examples",
    srcs = glob(["examples/evolution/*.json"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "desktop_assets",
    srcs = glob(["assets/desktop/*"]),
    visibility = ["//visibility:public"],
)

alias(
    name = "agent_research_lab",
    actual = "//app:app_service",
    visibility = ["//visibility:public"],
)

# Keep the executable at bazel-bin/agent-research-lab for service and package users.
rust_binary(
    name = "agent-research-lab",
    version = "0.1.0",
    srcs = ["//app:src/main.rs"],
    crate_root = "//app:src/main.rs",
    edition = "2024",
    aliases = aliases(package_name = "app"),
    deps = ["//app:app_service"] + all_crate_deps(normal = True, package_name = "app"),
    proc_macro_deps = all_crate_deps(proc_macro = True, package_name = "app"),
    visibility = ["//visibility:public"],
)

test_suite(
    name = "tests",
    tests = [
        "//app:serde_compatibility_tests",
        "//app:tests",
        "//crates/im-service:tests",
        "//crates/agent-backend:tests",
        "//crates/agent-policy:tests",
        "//crates/automation:tests",
        "//crates/budget:tests",
        "//crates/build-cache:tests",
        "//crates/collaboration-experiment:tests",
        "//crates/communication:tests",
        "//crates/crystal:tests",
        "//crates/config:tests",
        "//crates/delivery:tests",
        "//crates/evolution:tests",
        "//crates/evolution-cli:tests",
        "//crates/freshness:tests",
        "//crates/inputs:tests",
        "//crates/isolation:tests",
        "//crates/knowledge:tests",
        "//crates/lease-heartbeat:tests",
        "//crates/multi-agent:tests",
        "//crates/process:tests",
        "//crates/runtime:tests",
        "//crates/storage:tests",
        "//crates/targets:tests",
        "//crates/task:tests",
        "//crates/workflow:tests",
    ],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "package",
    srcs = [
        ":agent-research-lab",
        "//crates/im-storage:ai-im-storage",
        "//crates/im-storage:units",
        "//crates/service-workers:ai-im-services",
        "//crates/service-workers:units",
        "//app:systemd/agent-research-lab.service",
        "//app:systemd/agent-research-lab-dashboard.service",
    ] + glob(["examples/**", "prompts/**", "research/**", "skills/**", "assets/**", "*.md"]),
    package_dir = "agent-research-lab",
    strip_prefix = ".",
    extension = "tar.gz",
    mode = "0755",
    visibility = ["//visibility:public"],
)

# Minimal AI-IM core package; the main system also supports optional research scenarios.
alias(name = "ai-im", actual = "//crates/im-service:ai-im", visibility = ["//visibility:public"])
alias(name = "im-package", actual = "//crates/im-service:package", visibility = ["//visibility:public"])

filegroup(name = "policy_sources", srcs = [
    "//crates/service-workers:policy_sources",
    "//crates/service-api:policy_sources",
    "//crates/im-storage:policy_sources",
    "//crates/service-protocol:policy_sources",
    "//app:policy_sources",
    "//crates/agent-backend:policy_sources",
    "//crates/build-cache:policy_sources",
    "//crates/im-service:policy_sources",
    "//crates/lease-heartbeat:policy_sources",
    "//crates/contracts:policy_sources",
    "//crates/budget:policy_sources",
    "//crates/process:policy_sources",
    "//crates/agent-policy:policy_sources",
    "//crates/collaboration-experiment:policy_sources",
    "//crates/evolution-cli:policy_sources",
    "//crates/isolation:policy_sources",
    "//crates/crystal:policy_sources",
    "//crates/evolution:policy_sources",
    "//crates/automation:policy_sources",
    "//crates/storage:policy_sources",
    "//crates/targets:policy_sources",
    "//crates/knowledge:policy_sources",
    "//crates/multi-agent:policy_sources",
    "//crates/delivery:policy_sources",
    "//crates/config:policy_sources",
    "//crates/communication:policy_sources",
    "//crates/freshness:policy_sources",
    "//crates/task:policy_sources",
    "//crates/inputs:policy_sources",
    "//crates/runtime:policy_sources",
    "//crates/workflow:policy_sources",
    "//web/shared:policy_sources",
    "//crates/im-service/web:policy_sources",
    "//app/src/dashboard/web:policy_sources",
], visibility = ["//visibility:public"])
genrule(name = "source_inventory", srcs = [":policy_sources"], outs = ["source_inventory.txt"], cmd = "printf '%s\n' $(locations :policy_sources) > $@", visibility = ["//visibility:public"])
