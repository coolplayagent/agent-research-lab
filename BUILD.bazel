load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml", "Cargo.lock"])

rust_library(
    name = "agent_research_lab",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "agent-research-lab",
    srcs = ["src/main.rs"],
    edition = "2024",
    deps = [":agent_research_lab"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "tests",
    crate = ":agent_research_lab",
    deps = all_crate_deps(normal_dev = True),
)

filegroup(name = "package", srcs = [":agent-research-lab"] + glob(["examples/**", "prompts/**", "*.md"]), visibility = ["//visibility:public"])
