# Optional execution and knowledge services are installed separately from core collaboration.
pkg_tar(
    name = "adapter-package",
    srcs = ["//crates/knowledge-service:outcome-hub-knowledge", "//crates/service-workers:outcome-hub-services", "//crates/codex-adapter:outcome-hub-codex-adapter", "//crates/outcome-service:outcome-hub-outcomes", "//crates/service-workers:units", ],
    package_dir = "outcome-hub-adapters", extension = "tar.gz", mode = "0755",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "outcome-hub-cli",
    version = "0.1.0",
    srcs = ["//apps/cli:src/main.rs"],
    crate_root = "//apps/cli:src/main.rs",
    edition = "2024",
    aliases = aliases(package_name = "apps/cli"),
    deps = ["//apps/cli:outcome_hub_cli"] + all_crate_deps(normal = True, package_name = "apps/cli"),
    proc_macro_deps = all_crate_deps(proc_macro = True, package_name = "apps/cli"),
    visibility = ["//visibility:public"],
)
alias(name = "outcome-hub", actual = "//apps/outcome-hub:outcome-hub", visibility = ["//visibility:public"])

pkg_files(
    name = "windows-core-files",
    srcs = [":outcome-hub", "deploy/windows/README.txt"],
    visibility = ["//visibility:private"],
)

pkg_zip(
    name = "windows-package",
    srcs = [":windows-core-files"],
    out = "outcome-hub-windows-x86_64.zip",
    package_dir = "outcome-hub",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
)
alias(name = "outcome-hub-package", actual = "//crates/collaboration-api:package", visibility = ["//visibility:public"])

alias(name = "outcome-hub-migrate", actual = "//apps/migrate:outcome-hub-migrate", visibility = ["//visibility:public"])
alias(name = "migration-package", actual = "//apps/migrate:package", visibility = ["//visibility:public"])

# GitHub Pages is generated from committed documentation and linked examples.
PAGES_SOURCES = glob([
    "README*.md",
    "docs/**/*.md",
    "qualitygate/reviews/**/*.md",
    "examples/**",
])

filegroup(
    name = "page_sources",
    srcs = PAGES_SOURCES,
    visibility = ["//visibility:public"],
)

genrule(
    name = "pages-site",
    srcs = [":page_sources", "site/styles.css", "site/locales/en.json", "site/locales/zh-CN.json"],
    tools = ["site/build.mjs", "@im_node//:bin/node", "@im_marked//:lib/marked.esm.js"],
    outs = ["pages-site.tar.gz"],
    cmd = "set -eu; mkdir -p $(@D)/pages-site; $(location @im_node//:bin/node) $(location site/build.mjs) $(location @im_marked//:lib/marked.esm.js) $(@D)/pages-site $(location site/styles.css) $(location site/locales/en.json) $(location site/locales/zh-CN.json) $(locations :page_sources); tar -C $(@D)/pages-site --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -czf $@ .",
    visibility = ["//visibility:public"],
)

sh_test(
    name = "pages-site-test",
    srcs = ["site/check.sh"],
    data = [":pages-site", "site/check.py"] + PAGES_SOURCES,
    args = ["$(location :pages-site)"] + PAGES_SOURCES,
)
