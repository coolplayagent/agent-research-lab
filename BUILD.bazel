    "//crates/workflow-adapter:policy_sources",
    "//web/shared:policy_sources",
    "//web/outcome-hub:policy_sources",
    "//web/console:policy_sources",
], visibility = ["//visibility:public"])
genrule(name = "source_inventory", srcs = [":policy_sources"], outs = ["source_inventory.txt"], cmd = "printf '%s\n' $(locations :policy_sources) > $@", visibility = ["//visibility:public"])

# Optional execution and knowledge services are installed separately from core collaboration.
pkg_tar(
    name = "adapter-package",
    srcs = ["//crates/knowledge-service:outcome-hub-knowledge", "//crates/service-workers:outcome-hub-services", "//crates/codex-adapter:outcome-hub-codex-adapter", "//crates/outcome-service:outcome-hub-outcomes", "//crates/service-workers:ai-im-services", "//crates/service-workers:units", "//crates/codex-adapter:ai-im-codex-adapter", "//crates/outcome-service:ai-im-outcome-service"],
    package_dir = "outcome-hub-adapters", extension = "tar.gz", mode = "0755",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "outcome-hub-cli",
    version = "0.1.0",
    srcs = ["//apps/cli:src/main.rs"],
    crate_root = "//apps/cli:src/main.rs",
    edition = "2024",
    aliases = aliases(package_name = "apps/cli"),
    deps = ["//apps/cli:outcome_hub_cli"] + all_crate_deps(normal = True, package_name = "apps/cli"),
    proc_macro_deps = all_crate_deps(proc_macro = True, package_name = "apps/cli"),
    visibility = ["//visibility:public"],
)
alias(name = "outcome-hub", actual = "//apps/outcome-hub:outcome-hub", visibility = ["//visibility:public"])
alias(name = "outcome-hub-package", actual = "//crates/collaboration-api:package", visibility = ["//visibility:public"])
